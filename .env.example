# Google Antigravity OAuth Desktop Client Credentials
ZERO_G_OAUTH_CLIENT_ID=your-oauth-client-id.apps.googleusercontent.com
ZERO_G_OAUTH_CLIENT_SECRET=your-oauth-client-secret

# Server listening bind address (host:port)
ZERO_G_BIND=127.0.0.1:8080

# Optional per-provider custom API tokens (protects endpoints with Authorization: Bearer <token>)
# If unset, endpoints remain open / keyless.
# ZERO_G_API_TOKEN_AGY=secret-token-for-antigravity
# ZERO_G_API_TOKEN_CODEX=secret-token-for-codex
# ZERO_G_API_TOKEN_ZEN=secret-token-for-zen
