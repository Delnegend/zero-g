# Generate once with: openssl rand -base64 32
# Keep this key stable and back it up separately from the database.
ZERO_G_ENCRYPTION_KEY=

# Dashboard authentication is required for serve; use HTTPS outside localhost.
ZERO_G_DASHBOARD_AUTH=basic
ZERO_G_DASHBOARD_ORIGIN=http://127.0.0.1:8080
ZERO_G_DASHBOARD_USERNAME=admin
ZERO_G_DASHBOARD_PASSWORD=replace-with-a-strong-password

# Optional local database path (container default: /app/data/zero-g-logs.db).
# ZERO_G_LOG_DB=zero-g-logs.db

# For OIDC instead of basic, set ZERO_G_DASHBOARD_AUTH=oidc and:
# ZERO_G_OIDC_ISSUER=https://identity.example.com
# ZERO_G_OIDC_CLIENT_ID=
# ZERO_G_OIDC_CLIENT_SECRET=
# ZERO_G_OIDC_REDIRECT_URL=https://zero-g.example.com/auth/callback
# ZERO_G_OIDC_ALLOWED_EMAILS=admin@example.com
